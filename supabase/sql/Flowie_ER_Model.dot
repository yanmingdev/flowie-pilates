digraph Flowie {
graph [rankdir=TB, bgcolor="#F7F3EE", pad="0.35", nodesep="0.35", ranksep="0.65", splines=polyline, outputorder=edgesfirst, dpi=160, fontname="Noto Sans CJK TC", labelloc=t, label="Flowie V1 + 07  |  PostgreSQL ER model\n16 public tables + Supabase Auth reference  •  126 application columns  •  17 foreign keys"];
node [shape=plain,fontname="Noto Sans CJK TC"];
edge [color="#6D7D6C",fontname="DejaVu Sans",fontsize=9,dir=both,arrowsize=0.65,labeldistance=1.6,penwidth=1.1];
