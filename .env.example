# Copy this file to .env for the backend. These values are placeholders.
PORT=3001
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY
# Development-only bootstrap script; never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY

# Optional: only for the localhost demo history bootstrap, never a hosted database.
LOCAL_SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
